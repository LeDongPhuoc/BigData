{
  "version": 3,
  "description": "Backend credentials, session rotation, transaction quotas and idempotency",
  "collections": {
    "auth_credentials": {
      "edge": false,
      "schema": {
        "level": "strict",
        "message": "Invalid backend document",
        "rule": {
          "type": "object",
          "properties": {
            "created_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "updated_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "user_id": {
              "type": "string",
              "pattern": "^users/[A-Za-z0-9_-]+$"
            },
            "password_hash": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "created_at",
            "updated_at",
            "user_id",
            "password_hash"
          ],
          "additionalProperties": false
        }
      }
    },
    "auth_families": {
      "edge": false,
      "schema": {
        "level": "strict",
        "message": "Invalid backend document",
        "rule": {
          "type": "object",
          "properties": {
            "created_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "updated_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "user_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "expires_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "revoked_at": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "created_at",
            "updated_at",
            "user_id",
            "expires_at",
            "revoked_at"
          ],
          "additionalProperties": false
        }
      }
    },
    "auth_sessions": {
      "edge": false,
      "schema": {
        "level": "strict",
        "message": "Invalid backend document",
        "rule": {
          "type": "object",
          "properties": {
            "created_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "updated_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "user_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "family_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "token_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "status": {
              "enum": [
                "active",
                "used",
                "revoked"
              ]
            },
            "expires_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "used_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "revoked_at": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "created_at",
            "updated_at",
            "user_id",
            "family_id",
            "token_hash",
            "status",
            "expires_at",
            "used_at",
            "revoked_at"
          ],
          "additionalProperties": false
        }
      }
    },
    "idempotency_records": {
      "edge": false,
      "schema": {
        "level": "strict",
        "message": "Invalid backend document",
        "rule": {
          "type": "object",
          "properties": {
            "created_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "updated_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "actor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "operation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "payload_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "resource_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "created_at",
            "updated_at",
            "actor_id",
            "operation",
            "payload_hash",
            "resource_id"
          ],
          "additionalProperties": false
        }
      }
    },
    "rate_limits": {
      "edge": false,
      "schema": {
        "level": "strict",
        "message": "Invalid backend document",
        "rule": {
          "type": "object",
          "properties": {
            "created_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "updated_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "operation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "bucket": {
              "type": "integer",
              "minimum": 0
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "created_at",
            "updated_at",
            "operation",
            "bucket",
            "count"
          ],
          "additionalProperties": false
        }
      }
    },
    "connection_controls": {
      "edge": false,
      "schema": {
        "level": "strict",
        "message": "Invalid backend document",
        "rule": {
          "type": "object",
          "properties": {
            "created_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "updated_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "connection_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "uniqueItems": true,
              "maxItems": 2
            }
          },
          "required": [
            "created_at",
            "updated_at",
            "connection_id",
            "blockers"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "indexes": {
    "auth_credentials": [
      {
        "type": "persistent",
        "name": "credential_user",
        "fields": [
          "user_id"
        ],
        "unique": true,
        "sparse": false
      }
    ],
    "auth_families": [
      {
        "type": "persistent",
        "name": "families_user",
        "fields": [
          "user_id",
          "revoked_at"
        ],
        "unique": false,
        "sparse": false
      }
    ],
    "auth_sessions": [
      {
        "type": "persistent",
        "name": "sessions_family",
        "fields": [
          "family_id",
          "status"
        ],
        "unique": false,
        "sparse": false
      }
    ],
    "connections": [
      {
        "type": "persistent",
        "name": "connection_inviter",
        "fields": [
          "invited_by",
          "status",
          "created_at"
        ],
        "unique": false,
        "sparse": false
      }
    ],
    "referral_requests": [
      {
        "type": "persistent",
        "name": "candidate_inbox",
        "fields": [
          "candidate_id",
          "created_at"
        ],
        "unique": false,
        "sparse": false
      },
      {
        "type": "persistent",
        "name": "referral_expiry",
        "fields": [
          "status",
          "expires_at"
        ],
        "unique": false,
        "sparse": false
      }
    ],
    "applications": [
      {
        "type": "persistent",
        "name": "job_applications",
        "fields": [
          "job_id",
          "status",
          "created_at"
        ],
        "unique": false,
        "sparse": false
      }
    ],
    "notifications": [
      {
        "type": "persistent",
        "name": "notification_inbox",
        "fields": [
          "recipient_id",
          "created_at"
        ],
        "unique": false,
        "sparse": false
      }
    ],
    "users": [
      {
        "type": "persistent",
        "name": "active_users",
        "fields": [
          "status",
          "deleted_at"
        ],
        "unique": false,
        "sparse": false
      }
    ]
  }
}
